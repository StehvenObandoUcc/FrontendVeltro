# ENVIRONMENT CONFIGURATION - COPY TO .env AND FILL IN YOUR VALUES
# NEVER COMMIT THE .env FILE TO GIT - USE .env.example AS TEMPLATE ONLY

# ============ OpenAI / AI Vision API ============
# For GitHub Models API: use a GitHub PAT (ghp_...)
# For OpenAI: use an OpenAI key (sk-...)
OPENAI_API_KEY=your-api-key-here
OPENAI_API_ENDPOINT=https://models.inference.ai.azure.com/chat/completions
OPENAI_MODEL=gpt-4o-mini

# ============ Database Configuration ============
# PostgreSQL connection details (for local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=veltro_db
DB_USER=postgres
DB_PASSWORD=your-db-password-here

# ============ JWT Security ============
# Generate a strong 256-bit secret for production
# Example: openssl rand -base64 64
JWT_SECRET=your-256-bit-secret-key-min-32-characters-required-here

# ============ Application Profile ============
# Options: local, dev, prod
SPRING_PROFILES_ACTIVE=local

# ============ Server Configuration ============
SERVER_PORT=8080

# ============ CORS (Production only) ============
# Comma-separated list of allowed origins (Vercel frontend URL)
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# ============ Heroku-specific ============
# Heroku sets these automatically with the PostgreSQL addon:
# DATABASE_URL, JDBC_DATABASE_URL, DATABASE_USER, DATABASE_PASSWORD
# Heroku also sets PORT dynamically
